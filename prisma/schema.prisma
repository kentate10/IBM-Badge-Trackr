generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PM
  BA
}

enum Band {
  FOUNDATION
  EXPERIENCED
  EXPERT
}

enum Status {
  MET
  NOT_MET
  IN_PROGRESS
  BLOCKED
  // Added 2026-08-18: credential was earned before but has since lapsed —
  // currently only offered in the UI for renewal-based certs (ITIL). See
  // EXPIRABLE_ITEM_KEYS in lib/labels.ts. Applied to the live DB via a raw
  // `ALTER TYPE "Status" ADD VALUE` (see app/api/debug/run-update/route.ts's
  // ensureExpiredStatus()), same pattern as every other schema change this
  // sandbox can't push directly.
  EXPIRED
}

enum Tracker {
  SKILLS
  GENERAL
}

model Member {
  id          String     @id @default(cuid())
  name        String
  email       String     @unique
  role        Role
  band        Band
  slackHandle String?
  yearsAtIbm  Float?
  isManager   Boolean    @default(false)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  progress    Progress[]
  snapshots   Snapshot[]
  comments    Comment[]
}

// Defines every field that can appear in either tracker (Skills Tracker Week 0
// or General Tracker Week 0), scoped to the role/band it applies to. role/band
// null means "applies to everyone" (used for General Tracker items).
model SkillItem {
  id           String     @id @default(cuid())
  key          String     @unique
  label        String
  section      String
  tracker      Tracker
  role         Role?
  band         Band?
  hasPercent   Boolean    @default(true)
  optional     Boolean    @default(false)
  helpText     String?
  displayOrder Int        @default(0)
  progress     Progress[]
}

// The current value of one member x one skill item. Updated in place as
// people mark progress; history is captured separately via Snapshot.
model Progress {
  id          String    @id @default(cuid())
  memberId    String
  skillItemId String
  status      Status    @default(NOT_MET)
  percent     Int       @default(0)
  notes       String?
  updatedAt   DateTime  @updatedAt
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  skillItem   SkillItem @relation(fields: [skillItemId], references: [id], onDelete: Cascade)

  @@unique([memberId, skillItemId])
  @@index([memberId])
}

// A free-form, timestamped note on a member's profile. Unlike Member.notes
// (a single legacy field, kept as-is, not shown here) this is an append-only
// feed — multiple entries over time, each with its own date, shown on
// /member/[id]. Visible to the member themselves (read-only) as well as
// admins (who can add/delete) — same visibility as the existing notes
// banner already on that page.
model Comment {
  id        String   @id @default(cuid())
  memberId  String
  author    String?
  body      String
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([createdAt])
}

// A point-in-time rollup per member, created whenever an admin saves a
// weekly snapshot. Powers the progress-over-time trend chart.
model Snapshot {
  id               String          @id @default(cuid())
  memberId         String
  label            String
  takenAt          DateTime        @default(now())
  metCount         Int
  totalCount       Int
  percentComplete  Float
  member           Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  weeklySnapshot    WeeklySnapshot? @relation(fields: [weeklySnapshotId], references: [id], onDelete: SetNull)
  weeklySnapshotId String?

  @@index([takenAt])
  @@index([memberId])
}

// One row per "week saved" (admin clicks "Guardar snapshot semanal"). Holds
// the team-wide breakdown so the admin panel can be filtered to show the
// dashboard exactly as it looked for that week, not just the trend line.
// The per-member Snapshot rows above are linked to this via weeklySnapshotId.
model WeeklySnapshot {
  id               String     @id @default(cuid())
  label            String     @unique
  takenAt          DateTime   @default(now())
  teamPercent      Float
  // { MET, NOT_MET, IN_PROGRESS, BLOCKED, EXPIRED } counts across the whole team
  statusBreakdown  Json
  // [{ name, met, inProgress, blocked, notMet }] per tracker section
  sectionBreakdown Json
  memberSnapshots  Snapshot[]

  @@index([takenAt])
}

model LinkResource {
  id           String  @id @default(cuid())
  title        String
  url          String
  category     String
  description  String?
  displayOrder Int     @default(0)
}
