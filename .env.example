# Railway provides this automatically when you add a PostgreSQL service and
# reference it, e.g. DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@localhost:5432/badge_tracker"

# Password every team member uses to log in and edit their own progress.
TEAM_PASSWORD="change-me"

# Separate password for Ken's admin dashboard (overview, charts, edit anyone).
ADMIN_PASSWORD="change-me-too"

# Random long string used to sign the login session cookie. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"
